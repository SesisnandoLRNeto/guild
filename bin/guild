#!/usr/bin/env bash
# guild: talk to one quartermaster, ship with a party of adventurers.
# State lives in $GUILD_HOME (default ~/.guild). Sessions live in its own tmux server (socket "guild").
set -euo pipefail

GUILD_HOME="${GUILD_HOME:-$HOME/.guild}"
GUILD_REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SESSION="guild"
# Guild runs its own tmux server, so its config and keys never touch your normal tmux.
SOCKET="${GUILD_TMUX_SOCKET:-guild}"
tm() { tmux -L "$SOCKET" "$@"; }
QUESTS="$GUILD_HOME/quests"
# Under ~/Workspace so new worktrees inherit Claude folder trust (no trust prompt per quest).
WORKTREES="${GUILD_WORKTREES:-$HOME/Workspace/.guild-worktrees}"
EVENTS="$GUILD_HOME/events.log"
mkdir -p "$QUESTS" "$WORKTREES" "$GUILD_HOME/local"
touch "$EVENTS"

die() { echo "guild: $*" >&2; exit 1; }
now() { date +%Y-%m-%dT%H:%M:%S; }
qdir() { echo "$QUESTS/$1"; }
need_quest() { [ -d "$(qdir "$1")" ] || die "no quest '$1'"; }
current_quest() { echo "${1:-${GUILD_QUEST:-}}"; }

usage() {
  cat <<'EOF'
guild up [dir]                      open the cockpit: sidebar + quartermaster, one tab per quest
guild quest <slug> --repo PATH [--base REF] [--harness claude|openrouter|codex] [--model M]
                   [--brief FILE] [--ticket KEY] [--fresh] [--branch NAME]
                                    branch is TICKET/slug when a ticket is given, else quest/slug
                                    create a worktree + branch quest/<slug> and launch an adventurer
                                    (brief is read from stdin when --brief is not given)
guild roster                        list quests and their state
guild status <slug> <state> [note] [--no-wrapup]
                                    set state: working|blocked|needs-decision|done|failed|stopped
                                    (a code quest needs a wrap-up board before done; --no-wrapup opts out)
guild wait [timeout-seconds]        block until a new event arrives, then print it (default 1800s)
guild peek <slug> [lines]           show the last lines of an adventurer's screen
guild peek <slug> --calls [n]       the last tool calls and results, from the session log (works with calm on)
guild send <slug> <message>         type a message into an adventurer's session
guild check [slug] [--baseline]     run the brief's acceptance checks in the quest worktree (EDD)
guild check <slug> --reseal        accept a changed Acceptance block (guildmaster only)
guild vision <repo path>           collect a repo's merged, declined and reverted work (vision skill)
guild vision status <repo>         is there a sealed vision for this repo
guild jira once|watch|status       start quests from your @quartermaster comments on tickets
guild trial pass [note] | skip <reason>   record the trial result for HEAD (inside a quest)
guild board open --html FILE [--decisions FILE] [--title T] [--subtitle S] [--assets] [--wrapup] [--quest NAME]
                                    put a war table up for the guildmaster and open it in the browser
                                    (--wrapup marks it as the quest's end-of-work report)
guild board wait <id> [--timeout S]  block until the guildmaster answers that board, then print the answer
guild board list | guild board url   boards and their state, or the war table address
guild ask "<question>" [--detail T] [--option "id=Label: why"]... [--recommend id]
                                    put the question on the war table as a page and open it (inside a quest)
guild pool list|drop [repo]          the warm worktree pool quests are started from
guild new [dir] [name]              a plain Claude session in a new cockpit tab (Ctrl-g n, or click + claude)
guild shot <url> --name before|after [--width W --height H]
                                    a screenshot taken the same way every time, filed under the quest
guild revive [slug]                 bring an active quest's window back after a restart (all of them by default)
guild doctor                        check the setup: tools, config, identities, orphans
guild cost [slug] [--active]        what each quest spent (tokens, replies, time, dollars)
guild log [slug] [--since 7d] [--repo NAME]
                                    the history: quests, decisions, trials, cost; one slug tells its whole story
guild retro [--since 14d]           the facts a retro needs: overridden calls, skipped trials, stalls, spend
guild calm on|off|status            draw a party walking through a forest instead of tool calls (opt-in)
guild watch [seconds]               the cockpit sidebar: quests by repo, recent events (runs in a pane)
guild edit [slug|path]              your editor with the file tree: a quest, a folder, or your work root
guild close <slug> [--force]        kill the window, remove the worktree, archive the quest
EOF
}

event() { # slug state note
  printf '%s\t%s\t%s\t%s\n' "$(now)" "$1" "$2" "${3:-}" >> "$EVENTS"
}

# Calm mode is opt-in: it rides on an early-access Claude Code surface, so guild turns it
# on only for its own sessions, and only after `guild calm on`.
calm_on() { [ "$(cat "$GUILD_HOME/calm" 2>/dev/null | tr -d '[:space:]')" = "on" ]; }
calm_env() { calm_on && printf 'CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 GUILD_CALM=1 '; }

cmd_calm() {
  case "${1:-status}" in
    on) echo on > "$GUILD_HOME/calm"; echo "calm on: new guild sessions draw the party instead of tool calls (/calm toggles it inside a session)" ;;
    off) echo off > "$GUILD_HOME/calm"; echo "calm off: guild sessions draw normally again" ;;
    status) calm_on && echo on || echo off ;;
    *) die "usage: guild calm on|off|status" ;;
  esac
}

# The cockpit: window "qm" holds the sidebar and the quartermaster, every quest gets its
# own tab, and claude-deck gets one too when it is installed.
cmd_up() {
  local dir="${1:-$HOME}"
  if ! tm has-session -t "$SESSION" 2>/dev/null; then
    local sid resume=""
    if [ -s "$GUILD_HOME/qm-session" ]; then
      sid=$(cat "$GUILD_HOME/qm-session")
      resume="--resume '$sid'"          # same conversation as before the restart
    else
      # First reign: claude must be told the id, or there is nothing to resume later.
      sid=$(uuidgen | tr 'A-Z' 'a-z')
      echo "$sid" > "$GUILD_HOME/qm-session"
      resume="--session-id '$sid'"
    fi
    local qm="$(calm_env)GUILD_ROLE=qm claude --agent quartermaster --settings '$GUILD_HOME/qm-settings.json' -n quartermaster"
    tm -f "$GUILD_REPO/config/guild.tmux.conf" new-session -d -s "$SESSION" -n qm -c "$dir" "guild watch; exec \$SHELL"
    # If the stored session cannot be resumed (log gone), start a fresh one under a new id.
    tm split-window -h -l 76% -t "$SESSION:qm" -c "$dir" \
      "$qm $resume || { uuidgen | tr 'A-Z' 'a-z' > '$GUILD_HOME/qm-session'; $qm --session-id \"\$(cat '$GUILD_HOME/qm-session')\"; }; exec \$SHELL"
    cmd_layout
    command -v claude-deck >/dev/null && tm new-window -d -t "$SESSION" -n deck "claude-deck; exec \$SHELL"
    # The Jira watcher gets its own tab when jira.json says "watch": true, so you can see what it does.
    python3 -c "import json,sys;sys.exit(0 if json.load(open('$GUILD_HOME/local/jira.json')).get('watch') else 1)" 2>/dev/null \
      && tm new-window -d -t "$SESSION" -n jira "guild jira watch; exec \$SHELL"
    tm select-window -t "$SESSION:qm"
    tm select-pane -t "$SESSION:qm.1"
    cmd_revive >/dev/null 2>&1 || true   # quests that outlived the last session get their windows back
  fi
  if [ -n "${TMUX:-}" ]; then tm switch-client -t "$SESSION"; else tm attach -t "$SESSION"; fi
}

# A quest survives a restart on disk, but its tmux window does not. Revive relaunches the
# harness in the same worktree and tells it to continue where it stopped.
cmd_revive() {
  local only="${1:-}" revived=0 slug state
  tm has-session -t "$SESSION" 2>/dev/null || die "no guild session; run 'guild up' first"
  for d in "$QUESTS"/*/; do
    [ -f "$d/meta.json" ] || continue
    slug=$(basename "$d")
    [ -n "$only" ] && [ "$only" != "$slug" ] && continue
    state=$(cut -f1 "$d/status" 2>/dev/null)
    case "$state" in working|needs-decision|blocked|stopped) ;; *) continue ;; esac
    tm list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "$slug" && continue
    tm new-window -d -t "$SESSION" -n "$slug" "GUILD_RESUME=1 bash '$d/launch.sh'"
    event "$slug" "$state" "window revived after a restart"
    echo "revived $slug ($state)"
    revived=$((revived + 1))
  done
  [ "$revived" = 0 ] && echo "nothing to revive"
  return 0
}

cmd_cost() { GUILD_REPO="$GUILD_REPO" python3 "$GUILD_REPO/bin/ledger.py" cost "$@"; }
cmd_log()  { GUILD_REPO="$GUILD_REPO" python3 "$GUILD_REPO/bin/ledger.py" log "$@"; }

cmd_jira() { python3 "$GUILD_REPO/bin/jira_watch.py" "${1:-status}"; }

cmd_retro() { GUILD_REPO="$GUILD_REPO" python3 "$GUILD_REPO/bin/ledger.py" retro "$@"; }

cmd_doctor() { GUILD_TMUX_SOCKET="$SOCKET" GUILD_REPO="$GUILD_REPO" python3 "$GUILD_REPO/bin/doctor.py" "$@"; }

# A plain Claude session in its own cockpit tab, for work that is not a quest: reading,
# planning, a quick question. Named after the folder unless you give it a name.
cmd_new() {
  local dir="${1:-}" name="${2:-}"
  [ -n "$dir" ] || dir="${GUILD_EDIT_ROOT:-$HOME/Workspace}"
  dir="$(cd "$dir" 2>/dev/null && pwd)" || die "no such folder: ${1:-}"
  [ -n "$name" ] || name="claude:$(basename "$dir")"
  tm has-session -t "$SESSION" 2>/dev/null || die "no guild session; run 'guild up' first"
  local n=1 win="$name"
  while tm list-windows -t "$SESSION" -F '#W' | grep -qx "$win"; do n=$((n + 1)); win="$name-$n"; done
  tm new-window -t "$SESSION" -n "$win" -c "$dir" "$(calm_env)claude -n '$win'; exec \$SHELL"
  tm select-window -t "$SESSION:$win"
}

cmd_shot() { python3 "$GUILD_REPO/bin/shot.py" "$@"; }

# The sidebar gets about a quarter of the window: 24 to 36 columns. A fixed width broke
# narrow windows (a 99-column terminal squeezed the sidebar down to one column).
cmd_layout() {
  tm has-session -t "$SESSION" 2>/dev/null || return 0
  local w side
  w=$(tm display-message -p -t "$SESSION:qm" '#{window_width}' 2>/dev/null) || return 0
  side=$(( w * 28 / 100 )); [ "$side" -lt 24 ] && side=24; [ "$side" -gt 36 ] && side=36
  tm set-window-option -t "$SESSION:qm" main-pane-width "$side" >/dev/null
  tm select-layout -t "$SESSION:qm" main-vertical >/dev/null
}

cmd_watch() { GUILD_TMUX_SOCKET="$SOCKET" python3 "$GUILD_REPO/bin/watch.py" "${1:-2}"; }

# Your editor, the way you already use it: the file tree on the left, any file you want.
# Takes a quest slug, a path, or nothing (then GUILD_EDIT_ROOT, else ~/Workspace).
cmd_edit() {
  local target="${1:-}" dir="" win="edit" editor="${EDITOR:-nvim}"
  if [ -z "$target" ]; then
    dir="${GUILD_EDIT_ROOT:-$HOME/Workspace}"
  elif [ -d "$(qdir "$target")" ]; then
    dir=$(python3 -c "import json;print(json.load(open('$(qdir "$target")/meta.json'))['worktree'])")
    win="edit:$target"
  elif [ -d "$target" ]; then
    dir="$(cd "$target" && pwd)"
    win="edit:$(basename "$dir")"
  else
    die "guild edit takes a quest slug, a directory, or nothing"
  fi
  tm has-session -t "$SESSION" 2>/dev/null || die "no guild session; run 'guild up' first"
  if tm list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "$win"; then
    tm select-window -t "$SESSION:$win"
    return
  fi
  local cmd="$editor ."
  case "$editor" in *vim) cmd="$editor -c 'silent! Neotree show' ." ;; esac   # the tree, like LazyVim opens it
  tm new-window -t "$SESSION" -n "$win" -c "$dir" "$cmd; exec \$SHELL"
  tm select-window -t "$SESSION:$win"
  echo "editing $dir in tab $win"
}

# Resolve git identity + gh user from the repo's remote owner via local/identities.json.
identity_for() { # repo -> prints "name|email|gh_user" or empty
  local url owner
  url=$(git -C "$1" remote get-url origin 2>/dev/null || true)
  owner=$(echo "$url" | sed -E 's#^.*[:/]([^/]+)/[^/]+$#\1#')
  python3 - "$GUILD_HOME/local/identities.json" "$owner" <<'PY'
import json, sys, os
path, owner = sys.argv[1], sys.argv[2]
if not os.path.exists(path): sys.exit(0)
ids = json.load(open(path))
i = ids.get(owner) or ids.get("*")
if i: print(f"{i.get('name','')}|{i.get('email','')}|{i.get('gh_user','')}")
PY
}

# Claude asks "trust this folder?" for every new git checkout. A worktree is a copy of a repo the
# guildmaster chose, so it gets the same trust, but only if that repo (or a parent folder) is trusted.
inherit_trust() { # repo worktree
  python3 - "$1" "$2" <<'PY'
import json, os, sys, tempfile
repo, wt = sys.argv[1], sys.argv[2]
path = os.path.expanduser("~/.claude.json")
if not os.path.exists(path): sys.exit(0)
d = json.load(open(path))
projects = d.setdefault("projects", {})
p = repo
while True:
    if projects.get(p, {}).get("hasTrustDialogAccepted"):
        break
    parent = os.path.dirname(p)
    if parent == p:
        print(f"guild: {repo} is not trusted in Claude; the adventurer will ask once", file=sys.stderr)
        sys.exit(0)
    p = parent
projects.setdefault(wt, {})["hasTrustDialogAccepted"] = True
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(d, f, indent=2)
os.replace(tmp, path)
PY
}

harness_bin() { case "$1" in codex) echo codex ;; *) echo claude ;; esac; }

# Version managers (jenv, nvm, asdf, pyenv) read a pin file from the working directory.
# Those files are often untracked, so a fresh worktree would not have one, and the manager
# would walk up and use some parent's pin instead: a quest on a Java 25 repo would build
# with whatever ~/ says. Copy the pins the main checkout uses, when the worktree lacks them.
TOOLCHAIN_PINS=".java-version .nvmrc .node-version .tool-versions .python-version .ruby-version .sdkmanrc"

# Changes in a worktree, minus the toolchain pins guild itself copied in. Those are
# untracked on purpose; counting them would make every quest on such a repo look dirty
# forever, so nothing could close and no trial could pass.
worktree_dirty() { # worktree
  local pins; pins=$(printf '%s|' $TOOLCHAIN_PINS | sed 's/|$//; s/\./\\./g')
  git -C "$1" status --porcelain 2>/dev/null | grep -vE "^\?\? ($pins)\$" || true
}
export GUILD_TOOLCHAIN_PINS="$TOOLCHAIN_PINS"

carry_toolchain() { # repo worktree
  local f
  for f in $TOOLCHAIN_PINS; do
    [ -f "$1/$f" ] && [ ! -e "$2/$f" ] && cp "$1/$f" "$2/$f" && echo "toolchain: $f -> $(cat "$2/$f" | tr -d '\n')"
  done
  return 0
}

# A worktree pool, so a quest does not start from a cold checkout.
#
# A fresh worktree has no node_modules, no target/, no build cache, so the first build in
# every quest pays for everything again, in minutes and in tokens. Slots are reused
# instead: on close a slot is cleaned of tracked changes but keeps its ignored files, so
# the next quest on that repo starts warm. `git clean -fd` (no -x) is exactly that line:
# untracked files go, ignored build output stays.
POOL_MAX="${GUILD_POOL_MAX:-4}"

pool_root() { echo "$WORKTREES/pool"; }

# Is a slot taken? It is, when a quest that has not been archived points at it.
slot_busy() { # path
  python3 - "$QUESTS" "$1" <<'PY'
import json, os, sys
quests, path = sys.argv[1], sys.argv[2]
for slug in os.listdir(quests) if os.path.isdir(quests) else []:
    meta = os.path.join(quests, slug, "meta.json")
    if slug == "_archive" or not os.path.exists(meta):
        continue
    try:
        if json.load(open(meta)).get("worktree") == path:
            print("busy")
            break
    except (OSError, ValueError):
        continue
PY
}

# A slot for this repo: a free one if there is one, a new one while under the cap.
acquire_slot() { # repo -> prints path, or nothing when the pool is full
  local repo="$1" name n path
  name=$(basename "$repo")
  mkdir -p "$(pool_root)"
  for path in "$(pool_root)/$name-"*; do
    [ -d "$path" ] || continue
    [ -n "$(slot_busy "$path")" ] && continue
    git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || continue
    echo "reused $path"
    return 0
  done
  n=$(ls -d "$(pool_root)/$name-"* 2>/dev/null | wc -l | tr -d ' ')
  [ "$n" -ge "$POOL_MAX" ] && return 0
  path="$(pool_root)/$name-$((n + 1))"
  git -C "$repo" worktree add -q --detach "$path" HEAD || return 0
  echo "new $path"          # printed, not a variable: this runs inside $(...), a subshell
}

# Point a slot at this quest's branch, with a clean tree but its caches intact.
prepare_slot() { # worktree branch base
  git -C "$1" checkout -q -B "$2" "$3" || return 1
  git -C "$1" reset -q --hard "$3"
  git -C "$1" clean -qfd            # untracked go, ignored build output stays
}

# Back to the pool: no branch held, no leftovers, caches kept.
release_slot() { # worktree
  git -C "$1" checkout -q --detach 2>/dev/null || true
  git -C "$1" reset -q --hard 2>/dev/null || true
  git -C "$1" clean -qfd 2>/dev/null || true
}

cmd_pool() {
  case "${1:-list}" in
    list)
      printf '%-44s %s\n' SLOT STATE
      local path
      for path in "$(pool_root)"/*; do
        [ -d "$path" ] || continue
        printf '%-44s %s\n' "$(basename "$path")" "$([ -n "$(slot_busy "$path")" ] && echo busy || echo free)"
      done ;;
    drop)
      local path repo
      for path in "$(pool_root)"/*; do
        [ -d "$path" ] || continue
        [ -n "${2:-}" ] && case "$(basename "$path")" in "${2:-}"-*) ;; *) continue ;; esac
        [ -n "$(slot_busy "$path")" ] && { echo "skipped $(basename "$path"): in use"; continue; }
        repo=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's#/\.git$##')
        git -C "$repo" worktree remove --force "$path" 2>/dev/null || rm -rf "$path"
        echo "dropped $(basename "$path")"
      done ;;
    *) die "usage: guild pool list|drop [repo-name]" ;;
  esac
}

cmd_quest() {
  local slug="${1:-}"; shift || true
  [ -n "$slug" ] || die "quest needs a slug"
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slug must be lowercase letters, digits and dashes"
  local repo="" base="" harness="claude" model="" brief="" ticket="" fresh="" branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --harness) harness="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --brief) brief="$2"; shift 2 ;;
      --ticket) ticket="$2"; shift 2 ;;
      --fresh) fresh=1; shift ;;
      --branch) branch="$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [ -n "$repo" ] || die "quest needs --repo"
  case "$harness" in claude|openrouter|codex) ;; *) die "unknown harness $harness (claude, openrouter or codex)" ;; esac
  command -v "$(harness_bin "$harness")" >/dev/null || die "$(harness_bin "$harness") is not installed"
  repo="$(cd "$repo" && git rev-parse --show-toplevel)" || die "not a git repo: $repo"
  local q; q="$(qdir "$slug")"
  [ -e "$q" ] && die "quest '$slug' already exists"
  tm has-session -t "$SESSION" 2>/dev/null || die "no guild session; run 'guild up' first"

  if [ -z "$base" ]; then
    git -C "$repo" fetch -q origin 2>/dev/null || true
    base=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD || true)
    [ -n "$base" ] || base=$(git -C "$repo" symbolic-ref -q --short HEAD || echo HEAD)
  fi
  # Teams name branches after the ticket. Follow that when there is one, so a quest's
  # branch, PR and ticket line up without anyone renaming anything.
  if [ -z "$branch" ]; then
    if [ -n "$ticket" ]; then branch="$ticket/$slug"; else branch="quest/$slug"; fi
  fi

  local wt=""
  if [ -z "$fresh" ]; then
    local got; got=$(acquire_slot "$repo")
    if [ -n "$got" ]; then
      wt="${got#* }"
      prepare_slot "$wt" "$branch" "$base" || die "could not prepare the pooled worktree $wt"
      if [ "${got%% *}" = new ]; then
        echo "worktree: new pool slot $(basename "$wt")"
      else
        echo "worktree: reused $(basename "$wt"), build cache kept"
      fi
    fi
  fi
  if [ -z "$wt" ]; then          # --fresh, or the pool is full
    wt="$WORKTREES/$(basename "$repo")-$slug"
    git -C "$repo" worktree add -q -b "$branch" "$wt" "$base"
  fi
  inherit_trust "$repo" "$wt"
  carry_toolchain "$repo" "$wt"

  mkdir -p "$q"
  if [ -n "$brief" ]; then cp "$brief" "$q/brief.md"; else cat > "$q/brief.md"; fi
  [ -s "$q/brief.md" ] || die "empty brief"

  local ident name="" email="" ghu=""
  ident=$(identity_for "$repo")
  [ -n "$ident" ] && IFS='|' read -r name email ghu <<< "$ident"

  python3 - "$q/meta.json" <<PY
import json
json.dump({"slug": "$slug", "repo": "$repo", "worktree": "$wt", "branch": "$branch",
           "base": "$base", "harness": "$harness", "model": "$model",
           "identity": "$email", "gh_user": "$ghu", "ticket": "$ticket",
           "pooled": "${fresh:+no}${fresh:-yes}", "created": "$(now)"}, open("$q/meta.json", "w"), indent=2)
PY

  python3 "$GUILD_REPO/bin/checks.py" seal "$q"      # the acceptance contract, sealed with a hash
  local vision_file="$GUILD_HOME/visions/$(basename "$repo").md"

  sed -e "s#{{SLUG}}#$slug#g" -e "s#{{QDIR}}#$q#g" -e "s#{{BASE}}#$base#g" -e "s#{{REPO}}#$repo#g" \
    -e "s#{{BRANCH}}#$branch#g" -e "s#{{TICKET}}#${ticket:-none}#g" \
    "$GUILD_REPO/prompts/adventurer.md" > "$q/prompt.md"
  if [ -f "$vision_file" ]; then
    cat >> "$q/prompt.md" <<VISION

## This repo's vision

The guildmaster wrote down what this repo accepts and what it resists: \`$vision_file\`. Read it before you start.
When your change goes against it, or it does not say, stop and put the question on the war table. The vision is the guildmaster's, not yours to reinterpret.
VISION
  fi

  { echo "#!/usr/bin/env bash"
    echo "cd '$wt'"
    echo "export GUILD_QUEST='$slug' GUILD_HOME='$GUILD_HOME'"
    calm_on && echo "export CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 GUILD_CALM=1"
    [ -n "$name" ] && echo "export GIT_AUTHOR_NAME='$name' GIT_COMMITTER_NAME='$name'"
    [ -n "$email" ] && echo "export GIT_AUTHOR_EMAIL='$email' GIT_COMMITTER_EMAIL='$email'"
    [ -n "$ghu" ] && echo "export GH_TOKEN=\"\$(gh auth token --user '$ghu')\""
    # The gh shim gates `gh pr create` for every harness, not only the ones with hooks.
    echo "export PATH='$GUILD_REPO/bin/shims':\$PATH"
    echo 'resume=""; [ "${GUILD_RESUME:-}" = 1 ] && resume="--continue"'
    echo 'first="Start the quest."; [ "${GUILD_RESUME:-}" = 1 ] && first="You were interrupted by a restart. Check what you already did (git log, git status, the quest status), then carry on."'
    case "$harness" in
      claude)
        echo "claude --settings '$GUILD_HOME/worker-settings.json' --permission-mode auto -n 'quest:$slug' \$resume \\"
        echo "  --add-dir '$q' ${model:+--model '$model'} --append-system-prompt \"\$(cat '$q/prompt.md')\" \\"
        echo "  \"\$first Your brief is in $q/brief.md\"" ;;
      openrouter)
        # Claude Code speaks its own protocol to OpenRouter's Anthropic-compatible endpoint.
        # ANTHROPIC_API_KEY must be empty, or Claude Code goes to Anthropic instead.
        [ -f "$GUILD_HOME/local/env" ] && echo "set -a; . '$GUILD_HOME/local/env'; set +a"
        echo "[ -n \"\${OPENROUTER_API_KEY:-}\" ] || { echo 'guild: no OPENROUTER_API_KEY (put it in $GUILD_HOME/local/env)'; exec \$SHELL; }"
        echo "export ANTHROPIC_BASE_URL='https://openrouter.ai/api' ANTHROPIC_AUTH_TOKEN=\"\$OPENROUTER_API_KEY\" ANTHROPIC_API_KEY=''"
        echo "claude --settings '$GUILD_HOME/worker-settings.json' --permission-mode auto -n 'quest:$slug' \$resume \\"
        echo "  --add-dir '$q' ${model:+--model '$model'} --append-system-prompt \"\$(cat '$q/prompt.md')\" \\"
        echo "  \"\$first Your brief is in $q/brief.md\"" ;;
      codex)
        # workspace-write keeps Codex inside the worktree; --add-dir lets it report to guild.
        echo '[ "${GUILD_RESUME:-}" = 1 ] && exec codex resume --last'
        echo "codex -C '$wt' --add-dir '$GUILD_HOME' -s workspace-write -a never ${model:+-m '$model'} \\"
        echo "  \"\$(cat '$q/prompt.md')"$'\n\n'"Start the quest. Your brief is in $q/brief.md\"" ;;
      *) die "unknown harness $harness (claude, openrouter or codex)" ;;
    esac
    echo "exec \$SHELL"
  } > "$q/launch.sh"
  chmod +x "$q/launch.sh"

  printf 'working\tlaunched\t%s\n' "$(now)" > "$q/status"
  event "$slug" working "launched ($harness${model:+ $model}) in $wt"
  tm new-window -d -t "$SESSION" -n "$slug" "bash '$q/launch.sh'"
  echo "quest $slug: $harness${model:+/$model} on $(basename "$repo") [$base] branch=$branch identity=${email:-git default}"
}

cmd_roster() {
  if [ "${1:-}" = "--count" ]; then
    python3 "$GUILD_REPO/bin/watch.py" --count
    return
  fi
  printf '%-28s %-22s %-18s %-15s %s\n' QUEST REPO HARNESS STATE NOTE
  local d
  for d in "$QUESTS"/*/; do
    [ -f "$d/meta.json" ] || continue
    python3 - "$d" <<'PY'
import json, sys, os
d = sys.argv[1]
m = json.load(open(os.path.join(d, "meta.json")))
state, note, _ = (open(os.path.join(d, "status")).read().rstrip("\n").split("\t") + ["", "", ""])[:3]
h = m["harness"] + ("/" + m["model"] if m.get("model") else "")
print(f'{m["slug"]:<28} {os.path.basename(m["repo"]):<22} {h:<18} {state:<15} {note[:70]}')
PY
  done
}

# Has this quest actually committed code? A report is only owed when something changed.
quest_committed() { # slug
  local q wt base
  q="$(qdir "$1")"
  wt=$(python3 -c "import json;print(json.load(open('$q/meta.json')).get('worktree',''))" 2>/dev/null)
  base=$(python3 -c "import json;print(json.load(open('$q/meta.json')).get('base',''))" 2>/dev/null)
  [ -d "$wt" ] || return 0
  [ -n "$(git -C "$wt" log --oneline "$base..HEAD" 2>/dev/null | head -1)" ] && echo committed
  return 0
}

# A board marked as the quest's wrap-up (guild board open --wrapup).
wrapup_of() { # slug
  python3 - "$(qdir "$1")/boards" <<'PY'
import json, os, sys
root = sys.argv[1]
if os.path.isdir(root):
    for b in sorted(os.listdir(root)):
        meta = os.path.join(root, b, "board.json")
        try:
            if json.load(open(meta)).get("wrapup"):
                print(b)
                break
        except (OSError, ValueError):
            continue
PY
}

# Is there a board for this quest that the guildmaster has not answered yet?
open_board() { # slug
  python3 - "$(qdir "$1")/boards" <<'PY'
import os, sys
root = sys.argv[1]
if os.path.isdir(root):
    for b in sorted(os.listdir(root)):
        if os.path.exists(os.path.join(root, b, "board.json")) and not os.path.exists(os.path.join(root, b, "decision.json")):
            print(b)
            break
PY
}

cmd_status() {
  local slug="$1" state="$2"; shift 2
  local note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-wrapup) export GUILD_NO_WRAPUP=1; shift ;;
      *) note="$1"; shift ;;
    esac
  done
  need_quest "$slug"
  case "$state" in working|blocked|needs-decision|done|failed|stopped) ;; *) die "bad state $state" ;; esac
  # Every decision reaches the guildmaster as a page on the war table, never as a line of
  # terminal text. Without a board, guild builds one from the question itself.
  # Did this quest change code? Then "done" owes the guildmaster a wrap-up page.
  if [ "$state" = done ] && [ -z "${GUILD_NO_WRAPUP:-}" ] && [ -z "$(wrapup_of "$slug")" ] && [ -n "$(quest_committed "$slug")" ]; then
    die "this quest changed code, so 'done' needs a wrap-up board: build the page (war-table skill) and run
     guild board open --html <page> --assets --wrapup --title \"<what shipped>\"
     Nothing to show (docs, spec, an investigation)? Then: guild status $slug done --no-wrapup \"<result>\""
  fi

  local board=""
  [ "$state" = needs-decision ] && board=$(open_board "$slug")
  # A decision already on a board keeps that board's title when no note is given.
  if [ "$state" = needs-decision ] && [ -n "$board" ] && [ -z "$note" ]; then
    note="war table: $(python3 -c "import json;print(json.load(open('$(qdir "$slug")/boards/$board/board.json')).get('title',''))")"
  fi
  if [ "$state" = needs-decision ] && [ -z "$board" ]; then
    [ -n "$note" ] || die "needs-decision needs the question as its note"
    echo "guild: no board for this decision, putting the question on the war table" >&2
    GUILD_QUEST="$slug" python3 "$GUILD_REPO/bin/wartable.py" ask "$slug" "$note"
    return
  fi
  [ "$state" = done ] && [ -n "${GUILD_NO_WRAPUP:-}" ] && note="$note (no wrap-up)"
  printf '%s\t%s\t%s\n' "$state" "$note" "$(now)" > "$(qdir "$slug")/status"
  event "$slug" "$state" "$note"
}

# Boards that are not about a real quest (the quartermaster's own questions, a repo's
# vision) live under a small quest of their own, so every tool that reads quests works.
ensure_pseudo_quest() { # slug what
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "bad board quest name: $1"
  if [ ! -d "$(qdir "$1")" ]; then
    mkdir -p "$(qdir "$1")"
    python3 -c "import json,sys;json.dump({'slug':sys.argv[1],'repo':sys.argv[2],'harness':'','model':'','pseudo':True},open(sys.argv[3],'w'))" \
      "$1" "$2" "$(qdir "$1")/meta.json"
    printf 'working\t%s\t%s\n' "$2" "$(now)" > "$(qdir "$1")/status"
  fi
}

cmd_ask() {
  local slug; slug=$(current_quest)
  if [ -z "$slug" ]; then
    slug="quartermaster"            # the quartermaster asks too
    ensure_pseudo_quest "$slug" "the fleet"
  fi
  need_quest "$slug"
  [ $# -ge 1 ] || die 'usage: guild ask "<question>" [--detail T] [--option "id=Label: why"]... [--recommend id]'
  local question="$1"; shift
  python3 "$GUILD_REPO/bin/wartable.py" ask "$slug" "$question" "$@"
}

cmd_wait() {
  local timeout="${1:-1800}" cursor_file="$GUILD_HOME/.wait-cursor" cursor size waited=0
  cursor=$(cat "$cursor_file" 2>/dev/null || echo 0)
  while :; do
    size=$(wc -c < "$EVENTS" | tr -d ' ')
    if [ "$size" -gt "$cursor" ]; then
      tail -c +"$((cursor + 1))" "$EVENTS"
      echo "$size" > "$cursor_file"
      return 0
    fi
    [ "$waited" -ge "$timeout" ] && { echo "wait: no events in ${timeout}s"; return 0; }
    sleep 2; waited=$((waited + 2))
  done
}

# The screen, or with --calls the tool calls from the session log. Calm mode hides tool
# rows on screen, so the log is the only honest record of what an agent ran.
cmd_peek() {
  need_quest "$1"
  if [ "${2:-}" = "--calls" ]; then
    local wt; wt=$(python3 -c "import json;print(json.load(open('$(qdir "$1")/meta.json'))['worktree'])")
    python3 "$GUILD_REPO/bin/calls.py" "$wt" "${3:-15}"
    return
  fi
  tm capture-pane -p -t "$SESSION:$1" -S "-${2:-40}"
}

cmd_send() {
  need_quest "$1"
  tm send-keys -t "$SESSION:$1" -l "$2"
  sleep 0.3
  tm send-keys -t "$SESSION:$1" Enter
  printf 'working\t%s\t%s\n' "resumed after message" "$(now)" > "$(qdir "$1")/status"
  event "$1" message "guildmaster: ${2:0:80}"
}

# A repo's written values: evidence collected here, judgment in the vision skill.
cmd_vision() {
  local sub="${1:-}"
  case "$sub" in
    ""|-h|--help) die "usage: guild vision <repo path> [--min N]   |   guild vision status <repo path or name>" ;;
    status|show)
      local target="${2:-.}"
      [ -d "$target" ] && target=$(basename "$(cd "$target" && git rev-parse --show-toplevel 2>/dev/null || pwd)")
      python3 "$GUILD_REPO/bin/vision.py" status "$target" ;;
    *)
      local repo; repo="$(cd "$sub" && git rev-parse --show-toplevel)" || die "not a git repo: $sub"
      shift
      local ident ghu=""
      ident=$(identity_for "$repo")
      [ -n "$ident" ] && ghu=$(echo "$ident" | cut -d'|' -f3)
      # read the repo's history with the account that owns it
      [ -n "$ghu" ] && export GH_TOKEN="$(gh auth token --user "$ghu" 2>/dev/null || true)"
      python3 "$GUILD_REPO/bin/vision.py" evidence "$repo" "$@"
      echo "next: use the vision skill to draft principles and put the hard questions on the war table" ;;
  esac
}

# EDD: the brief's acceptance checks, run in the quest's worktree.
cmd_check() {
  local slug="" baseline="" reseal="" timeout="900"
  while [ $# -gt 0 ]; do
    case "$1" in
      --baseline) baseline="--baseline"; shift ;;
      --reseal) reseal=1; shift ;;
      --timeout) timeout="$2"; shift 2 ;;
      *) slug="$1"; shift ;;
    esac
  done
  slug=$(current_quest "$slug")
  [ -n "$slug" ] || die "usage: guild check [slug] [--baseline] [--timeout S]  (inside a quest the slug is implicit)"
  need_quest "$slug"
  local q wt out rc
  q="$(qdir "$slug")"
  if [ -n "$reseal" ]; then
    # Accepting a changed brief is the guildmaster's call, never the adventurer's.
    [ -n "${GUILD_QUEST:-}" ] && die "only the guildmaster reseals acceptance; escalate on the war table instead"
    python3 "$GUILD_REPO/bin/checks.py" reseal "$q"
    event "$slug" acceptance "resealed by the guildmaster"
    return
  fi
  wt=$(python3 -c "import json;print(json.load(open('$q/meta.json'))['worktree'])")
  set +e
  out=$(python3 "$GUILD_REPO/bin/checks.py" run "$q" "$wt" $baseline --timeout "$timeout")
  rc=$?
  set -e
  printf '%s\n' "$out" | grep -v '^__EVENT__'
  local ev; ev=$(printf '%s\n' "$out" | grep '^__EVENT__' | tail -1)
  [ -n "$ev" ] && event "$slug" "$(echo "$ev" | cut -f2)" "$(echo "$ev" | cut -f3)"
  return $rc
}

cmd_trial() {
  local slug; slug=$(current_quest)
  [ -n "$slug" ] || die "trial must run inside a quest (GUILD_QUEST not set)"
  need_quest "$slug"
  local result="${1:-}" note="${2:-}" sha
  case "$result" in
    pass) ;;
    skip) [ -n "$note" ] || die "skip needs a reason, e.g. guild trial skip \"spec only, no code\"" ;;
    *) die "usage: guild trial pass [note] | skip <reason>" ;;
  esac
  sha=$(git rev-parse HEAD)
  if [ "$result" = pass ]; then
    local why
    why=$(python3 "$GUILD_REPO/bin/checks.py" status "$(qdir "$slug")" "$sha") || die "trial refused: $why"
  fi
  python3 -c "import json,sys;json.dump({'sha':sys.argv[1],'result':sys.argv[2],'note':sys.argv[3],'at':sys.argv[4]},open(sys.argv[5],'w'),indent=2)" \
    "$sha" "$result" "$note" "$(now)" "$(qdir "$slug")/trial.json"
  event "$slug" "trial-$result" "${note:-$sha}"
  echo "trial $result recorded for $sha"
}

# War table. Inside a quest the slug is implicit, so `guild board open --html page.html` is enough.
cmd_board() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    open|wait)
      local slug="" rest=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --quest) slug="$2"; shift 2 ;;
          *) rest+=("$1"); shift ;;
        esac
      done
      if [ -n "$slug" ]; then
        ensure_pseudo_quest "$slug" "board: $slug"
      else
        slug=$(current_quest)
      fi
      [ -n "$slug" ] || die "guild board $sub needs a quest: run it inside one, or pass --quest <name>"
      need_quest "$slug"
      python3 "$GUILD_REPO/bin/wartable.py" "$sub" "$slug" ${rest[@]+"${rest[@]}"} ;;
    list|url) python3 "$GUILD_REPO/bin/wartable.py" "$sub" "$@" ;;
    *) die "usage: guild board open|wait|list|url" ;;
  esac
}

cmd_close() {
  local slug="$1" force="${2:-}"
  need_quest "$slug"
  local q wt repo
  q="$(qdir "$slug")"
  wt=$(python3 -c "import json;print(json.load(open('$q/meta.json'))['worktree'])")
  repo=$(python3 -c "import json;print(json.load(open('$q/meta.json'))['repo'])")
  local branch; branch=$(python3 -c "import json;print(json.load(open('$q/meta.json')).get('branch') or 'quest/$slug')")
  if [ -d "$wt" ] && [ -n "$(worktree_dirty "$wt")" ] && [ "$force" != "--force" ]; then
    die "worktree $wt has uncommitted changes; use --force to drop them"
  fi
  # The session logs stay on disk, but freeze the numbers now so history never drifts.
  python3 "$GUILD_REPO/bin/ledger.py" snapshot "$slug" >/dev/null 2>&1 || true
  tm kill-window -t "$SESSION:$slug" 2>/dev/null || true
  if [ -d "$wt" ]; then
    case "$wt" in
      "$(pool_root)"/*) release_slot "$wt"; echo "worktree returned to the pool, cache kept" ;;
      *) git -C "$repo" worktree remove ${force:+--force} "$wt" ;;
    esac
  fi
  python3 - "$wt" <<'PY'
import json, os, sys, tempfile
path = os.path.expanduser("~/.claude.json")
if os.path.exists(path):
    d = json.load(open(path))
    if d.get("projects", {}).pop(sys.argv[1], None) is not None:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
        with os.fdopen(fd, "w") as f:
            json.dump(d, f, indent=2)
        os.replace(tmp, path)
PY
  mkdir -p "$QUESTS/_archive"
  mv "$q" "$QUESTS/_archive/$slug-$(date +%Y%m%d%H%M%S)"
  event "$slug" closed ""
  echo "closed $slug (branch $branch kept in $repo)"
}

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  quest) shift; cmd_quest "$@" ;;
  roster) shift; cmd_roster "$@" ;;
  status) shift; [ $# -ge 2 ] || die "usage: guild status <slug> <state> [note]"; cmd_status "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  peek) shift; [ $# -ge 1 ] || die "usage: guild peek <slug> [lines]"; cmd_peek "$@" ;;
  send) shift; [ $# -ge 2 ] || die "usage: guild send <slug> <message>"; cmd_send "$@" ;;
  trial) shift; cmd_trial "$@" ;;
  board) shift; cmd_board "$@" ;;
  ask) shift; cmd_ask "$@" ;;
  calm) shift; cmd_calm "$@" ;;
  revive) shift; cmd_revive "$@" ;;
  pool) shift; cmd_pool "$@" ;;
  shot) shift; cmd_shot "$@" ;;
  new) shift; cmd_new "$@" ;;
  layout) cmd_layout ;;
  check) shift; cmd_check "$@" ;;
  vision) shift; cmd_vision "$@" ;;
  jira) shift; cmd_jira "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  cost) shift; cmd_cost "$@" ;;
  log) shift; cmd_log "$@" ;;
  retro) shift; cmd_retro "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  edit) shift; cmd_edit "$@" ;;
  close) shift; [ $# -ge 1 ] || die "usage: guild close <slug> [--force]"; cmd_close "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command $1 (see guild help)" ;;
esac
